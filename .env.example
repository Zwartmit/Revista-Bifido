# Payload CMS Secret
PAYLOAD_SECRET=your-payload-secret-key

# Base de Datos (PostgreSQL via Supabase u otro)
DATABASE_URI=postgresql://postgres:admin@localhost:5432/revista-bifido

# URL del servidor (Usar el dominio real en producción, ej: https://revista-bifido.vercel.app)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Email — Resend
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=onboarding@resend.dev

# --- Configuración de Almacenamiento Permanente (Cloudflare R2) ---
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET=revista-bifido
S3_REGION=auto
S3_PUBLIC_URL=https://pub-xxxxxx.r2.dev

