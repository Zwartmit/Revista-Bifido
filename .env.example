# Payload CMS Configuration
PAYLOAD_SECRET=your-payload-secret-key-here-min-32-chars
DATABASE_URI=mongodb://localhost:27017/revista-bifido
# Alternative for PostgreSQL: postgresql://user:password@localhost:5432/revista-bifido

# Payload Admin URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Revalidation Secret (para webhooks)
REVALIDATE_SECRET=your-secret-key-here

# Analytics (opcional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Email Service (para formulario de contacto)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
CONTACT_EMAIL=bifidomedio@gmail.com
